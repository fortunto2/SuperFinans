  "strings": {
    "When can you stop working?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When can you stop working?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann kannst du aufhören zu arbeiten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo podrás dejar de trabajar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand pourrez-vous arrêter de travailler ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando potrai smettere di lavorare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ働くのをやめられますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 일을 그만둘 수 있을까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você pode parar de trabalhar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы сможете не работать?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman çalışmayı bırakabilirsin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你什么时候可以不再工作？"
          }
        }
      }
    },
    "Not a budget. Not a spending report. One number: the year your money starts covering your life instead of your salary.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a budget. Not a spending report. One number: the year your money starts covering your life instead of your salary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Budget. Kein Ausgabenbericht. Eine Zahl: das Jahr, in dem dein Geld dein Leben trägt statt deines Gehalts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un presupuesto ni un informe de gastos. Un número: el año en que tu dinero cubre tu vida en lugar de tu sueldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni budget ni rapport de dépenses. Un chiffre : l'année où votre argent couvre votre vie à la place de votre salaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un budget né un report di spese. Un numero: l'anno in cui i tuoi soldi coprono la tua vita al posto dello stipendio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家計簿でも支出レポートでもありません。数字はひとつ、給料の代わりに資産が生活費をまかなう年です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산도 지출 보고서도 아닙니다. 숫자는 하나, 월급 대신 자산이 생활비를 감당하기 시작하는 해입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é orçamento nem relatório de gastos. Um número: o ano em que seu dinheiro cobre sua vida no lugar do salário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не бюджет и не отчёт о тратах. Одно число: год, когда деньги начнут покрывать вашу жизнь вместо зарплаты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçe değil, harcama raporu değil. Tek bir sayı: paranızın maaşınızın yerine geçtiği yıl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是预算，也不是消费报告。只有一个数字：你的钱开始代替工资供养生活的那一年。"
          }
        }
      }
    },
    "Three numbers, one minute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three numbers, one minute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Zahlen, eine Minute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres números, un minuto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois chiffres, une minute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre numeri, un minuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの数字、1分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자 셋, 1분"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três números, um minuto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три числа, одна минута"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç sayı, bir dakika"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个数字，一分钟"
          }
        }
      }
    },
    "What life costs, what you have invested, what you add each month. No bank login, no month of collecting receipts before the app says anything.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What life costs, what you have invested, what you add each month. No bank login, no month of collecting receipts before the app says anything."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das Leben kostet, was investiert ist, was monatlich dazukommt. Kein Bank-Login, kein Monat Belege sammeln, bevor die App etwas sagt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuesta vivir, lo que tienes invertido, lo que añades cada mes. Sin acceso bancario ni un mes recogiendo recibos antes de obtener una respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que coûte la vie, ce qui est investi, ce que vous ajoutez chaque mois. Sans connexion bancaire ni un mois de tickets avant la moindre réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto costa vivere, quanto hai investito, quanto aggiungi ogni mese. Nessun accesso bancario, nessun mese di scontrini prima di una risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活費、投資済みの額、毎月の積立額。銀行ログインも、答えが出るまでのレシート集めも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생활비, 이미 투자한 금액, 매달 넣는 금액. 은행 연동도, 답을 듣기까지 영수증을 모으는 한 달도 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto custa viver, quanto você investiu, quanto adiciona por mês. Sem login bancário nem um mês juntando recibos antes de qualquer resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько стоит жизнь, сколько уже вложено, сколько добавляете в месяц. Без входа в банк и без месяца сбора чеков до первого ответа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşamın maliyeti, yatırdığınız tutar, her ay eklediğiniz miktar. Banka girişi yok, cevap almadan önce bir ay fiş toplamak yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生活开销、已投资的金额、每月新增的金额。不用连接银行，也不用先攒一个月的收据。"
          }
        }
      }
    },
    "Nothing leaves the phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves the phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verlässt das Telefon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte le téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente lascia il telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も端末から出ません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 기기를 벗어나지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sai do telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не покидает телефон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey telefondan çıkmaz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据不会离开手机"
          }
        }
      }
    },
    "No account, no ads, no third parties. Not one amount you type is ever sent — the arithmetic runs here. The app counts how often it is opened, which is a count, not a trail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no ads, no third parties. Not one amount you type is ever sent — the arithmetic runs here. The app counts how often it is opened, which is a count, not a trail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Werbung, keine Dritten. Kein eingegebener Betrag wird gesendet — gerechnet wird hier. Die App zählt, wie oft sie geöffnet wird: eine Zählung, keine Spur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin terceros. Ningún importe que escribas se envía: el cálculo ocurre aquí. La app cuenta cuántas veces se abre, y eso es un recuento, no un rastro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de pub, pas de tiers. Aucun montant saisi n'est envoyé : le calcul se fait ici. L'app compte ses ouvertures — un décompte, pas un pistage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna pubblicità, nessuna terza parte. Nessun importo digitato viene inviato: il calcolo avviene qui. L'app conta quante volte viene aperta: un conteggio, non una traccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも広告も第三者もありません。入力した金額は一切送信されず、計算は端末で行われます。アプリが数えるのは起動回数だけ。追跡ではなく集計です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도, 광고도, 제3자도 없습니다. 입력한 금액은 전송되지 않고 계산은 이 기기에서 이루어집니다. 앱이 세는 것은 실행 횟수뿐이며, 이는 추적이 아니라 집계입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem anúncios, sem terceiros. Nenhum valor digitado é enviado — a conta é feita aqui. O app conta quantas vezes é aberto: é contagem, não rastro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни аккаунта, ни рекламы, ни третьих лиц. Ни одна введённая сумма не уходит — расчёт идёт здесь. Приложение считает запуски: это счёт, а не слежка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, reklam yok, üçüncü taraf yok. Yazdığınız hiçbir tutar gönderilmez — hesap burada yapılır. Uygulama yalnızca kaç kez açıldığını sayar; bu takip değil, sayımdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账号，没有广告，没有第三方。你输入的金额一分不会外传，计算都在本机完成。应用只统计打开次数——那是计数，不是追踪。"
          }
        }
      }
    },
